{
  "mcpServers": {
    "adrs": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "adrs",
      "cwd": "/Users/jack/Documents/41_personal/zotero-mcp-rs/",
      "env": {
        "ADR_DIRECTORY": "docs/adr/"
      }
    },
    "mise": {
      "args": [
        "mcp"
      ],
      "command": "/opt/homebrew/bin/mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      }
    },
    "rust-docs": {
      "command": "rust-docs-mcp",
      "env": {
        "RUST_DOCS_MCP_CACHE_DIR": ".rust-docs/cache/"
      }
    }
  }
}
