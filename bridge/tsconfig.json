{
  "extends": "zotero-types/entries/sandbox",
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    "noEmitOnError": true,
    "composite": false,
    // Keep generated scripts at bridge/ so Zotero can load them directly.
    "rootDir": "src",
    "outDir": "."
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": []
}
